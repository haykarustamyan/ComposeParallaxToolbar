root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = intellij_idea
max_line_length = 140
# Composables are PascalCase by convention; ktlint's naming rule allows that when told.
ktlint_function_naming_ignore_when_annotated_with = Composable, Preview
# Compose code reads better with argument lists kept on one line when they fit.
ktlint_standard_function-signature = disabled
ktlint_standard_class-signature = disabled
# Public constants such as ParallaxToolbarDefaults.ToolbarHeight follow Compose's PascalCase convention.
ktlint_standard_property-naming = disabled
# Sample and preview files import whole packages on purpose.
ktlint_standard_no-wildcard-imports = disabled

# Functions that build UIViewControllers for Swift keep their iOS-style names.
[**/iosMain/**/*.kt]
ktlint_standard_function-naming = disabled

[*.md]
trim_trailing_whitespace = false
